#The Sales Trend Visualization 
Prediction Dashboard is a Data Science project developed toanalyze monthly sales performance.
and forecast future sales trends using Machine Learning techniques. 
The dashboard provides interactive visualizations, sales comparisons,
and predictive analysis to help businesses understand growth patterns and make data-driven decisions.

import streamlit as st
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
import numpy as np

# -----------------------------------
# Dashboard Title
# -----------------------------------
st.title("Sales Trend Visualization & Prediction Dashboard")

# -----------------------------------
# Different Dataset
# -----------------------------------
data = {
    "Order Date": [
        "2024-01-08",
        "2024-02-14",
        "2024-03-19",
        "2024-04-11",
        "2024-05-09",
        "2024-06-16",
        "2024-07-22"
    ],

    "Sales": [
        10000,
        14000,
        9000,
        18000,
        24000,
        21000,
        30000
    ],

    "Category": [
        "Mobile Phones",
        "Laptop Accessories",
        "Home Appliances",
        "Food Products",
        "Healthcare",
        "Stationery",
        "Automobile Parts"
    ]
}

# Create DataFrame
df = pd.DataFrame(data)

# Convert Date
df["Order Date"] = pd.to_datetime(df["Order Date"])

# Add Month Number
df["Month_Number"] = [1, 2, 3, 4, 5, 6, 7]

# -----------------------------------
# Dataset Preview
# -----------------------------------
st.header("Dataset Preview")
st.dataframe(df)

# -----------------------------------
# Monthly Sales Trend
# -----------------------------------
st.header("Monthly Sales Trend")

months = [1, 2, 3, 4, 5, 6, 7]
monthly_sales = [10000, 14000, 9000, 18000, 24000, 21000, 30000]

fig, ax = plt.subplots(figsize=(8, 5))

ax.plot(months, monthly_sales, marker='o')

ax.set_title("Monthly Sales Trend")
ax.set_xlabel("Month")
ax.set_ylabel("Sales")

st.pyplot(fig)

# -----------------------------------
# Sales Bar Chart
# -----------------------------------
st.header("Sales Bar Chart")

fig2, ax2 = plt.subplots(figsize=(8, 5))

ax2.bar(months, monthly_sales)

ax2.set_title("Monthly Sales Comparison")
ax2.set_xlabel("Month")
ax2.set_ylabel("Sales")

st.pyplot(fig2)

# -----------------------------------
# Sales Prediction Analysis
# -----------------------------------
st.header("Sales Prediction Analysis")

X = np.array(months).reshape(-1, 1)
y = np.array(monthly_sales)

# Train Model
model = LinearRegression()
model.fit(X, y)

# Future Predictions
future_months = np.array([8, 9, 10]).reshape(-1, 1)
predictions = model.predict(future_months)

# Prediction Table
prediction_df = pd.DataFrame({
    "Future Month": [8, 9, 10],
    "Predicted Sales": predictions.astype(int)
})

st.write(prediction_df)

# Prediction Graph
fig3, ax3 = plt.subplots(figsize=(8, 5))

# Actual Sales
ax3.plot(
    months,
    monthly_sales,
    marker='o',
    label='Actual Sales'
)

# Predicted Sales
ax3.plot(
    [8, 9, 10],
    predictions,
    marker='o',
    linestyle='--',
    label='Predicted Sales'
)

ax3.set_title("Sales Prediction")
ax3.set_xlabel("Month")
ax3.set_ylabel("Sales")

ax3.legend()

st.pyplot(fig3)
